<Window x:Class="Missiva.UI.MenuCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalizza il menu" Width="560" Height="720" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/missiva.ico">
    <DockPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Explanation" DockPanel.Dock="Top" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Ripristina il menu di Outlook" Click="OnReset" />
            <Button DockPanel.Dock="Right" Content="Fatto" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" IsCancel="True" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="160">
            <Button x:Name="UpButton" Click="OnUp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Su" />
                </StackPanel>
            </Button>
            <Button x:Name="DownButton" Click="OnDown" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Giù" />
                </StackPanel>
            </Button>
            <Button Click="OnAddSeparator" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Separatore" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveButton" Click="OnRemoveSeparator" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Togli separatore" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border CornerRadius="8" BorderThickness="1" Padding="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox x:Name="Entries" BorderThickness="0" Background="Transparent" AllowDrop="True" SelectionChanged="OnSelected"
                     PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                     DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop" KeyDown="OnKey"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="{Binding DropLine}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Padding="0,2">
                            <Grid>
                                <!-- Voce: casella, icona e nome -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding EntryVisibility}" Height="36">
                                    <CheckBox IsChecked="{Binding Shown}" Click="OnShownClick" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <ContentControl Content="{Binding Icon}" Width="24" VerticalAlignment="Center" Focusable="False" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Separatore: una linea -->
                                <Grid Visibility="{Binding SeparatorVisibility}" Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Separatore" FontSize="12" Margin="34,0,10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
